# Copy this file to .env.local and fill in the values.

# ---------------------------------------------------------------
# Website (safe to expose: Vite only bundles variables starting with VITE_)
# Supabase: Project settings > API
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: your Telegram bot's username without the @, shows the Connect Telegram button
VITE_TELEGRAM_BOT_USERNAME=
# Optional: your WhatsApp business number, digits only with country code, e.g. 919876543210
VITE_WHATSAPP_NUMBER=

# ---------------------------------------------------------------
# Fetcher and scripts (server side only, never put these in VITE_ variables)
# ---------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Bypasses all access rules. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your deployed site address, used in email and Telegram links
SITE_URL=http://localhost:5173

# Email alerts (resend.com)
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Easy Apply <alerts@yourdomain.com>"
EMAIL_FROM=

# Telegram alerts (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
# Any long random string. Telegram sends it back with every webhook call.
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp alerts (Meta WhatsApp Cloud API, developers.facebook.com)
# Token: a permanent System User token with the whatsapp_business_messaging permission
WHATSAPP_TOKEN=
# Phone number ID (not the phone number), from WhatsApp > API setup
WHATSAPP_PHONE_NUMBER_ID=
# Any long random string you also type into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# App secret, from App settings > Basic. Used to check that webhook calls come from Meta
WHATSAPP_APP_SECRET=
# Name of your approved message template (see README). Needed to message people
# who have not written to the bot in the last 24 hours.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Fetcher tuning (optional)
FETCH_CONCURRENCY=5
# Set to true to store jobs from every country instead of India only
INGEST_ALL=false
